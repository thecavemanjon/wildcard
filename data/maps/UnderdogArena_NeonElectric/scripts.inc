@ Daily Underdog arena (generated by wildcard/art/arenas/build_arenas.py): the NeonElectric stadium (the opponent waits on the right; you start on the left).
@ The battle is the shared UnderdogArena_EventScript_Opponent.
UnderdogArena_NeonElectric_MapScripts::
	map_script MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE, UnderdogArena_NeonElectric_OnWarp
	.byte 0

UnderdogArena_NeonElectric_OnWarp:
	map_script_2 VAR_TEMP_1, 0, UnderdogArena_NeonElectric_EventScript_PlayerTurn
	.2byte 0

UnderdogArena_NeonElectric_EventScript_PlayerTurn::
	turnobject LOCALID_PLAYER, DIR_EAST
	setvar VAR_TEMP_1, 1
	end
